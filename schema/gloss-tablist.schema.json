{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volmit.com/gloss/tablist.schema.json",
  "title": "Gloss Tablist Document",
  "type": "object",
  "properties": {
    "preset": {"type": ["string", "null"], "minLength": 1, "description": "Named preset from this collection in presets.json; document fields override inherited values."},
    "schemaVersion": {
      "const": 3
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "show": {
      "type": [
        "string",
        "boolean"
      ],
      "description": "Boolean or Gloss condition expression."
    },
    "headerFooter": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "show": {
          "type": [
            "string",
            "boolean"
          ],
          "description": "Boolean or Gloss condition expression."
        },
        "presentation": {
          "$ref": "#/$defs/headerFooterPresentation"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "integer"
              },
              "when": {
                "type": "string",
                "minLength": 1
              },
              "presentation": {
                "$ref": "#/$defs/headerFooterPresentation"
              }
            },
            "required": [
              "id",
              "when",
              "presentation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "listNames": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "show": {
          "type": [
            "string",
            "boolean"
          ],
          "description": "Boolean or Gloss condition expression."
        },
        "presentation": {
          "$ref": "#/$defs/listNamePresentation"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "integer"
              },
              "when": {
                "type": "string",
                "minLength": 1
              },
              "presentation": {
                "$ref": "#/$defs/listNamePresentation"
              }
            },
            "required": [
              "id",
              "when",
              "presentation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "sort": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "weight": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "weight"
            ]
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "skins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/skin"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "show": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutVariant"
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "revision"
  ],
  "additionalProperties": false,
  "$defs": {
    "headerFooterPresentation": {
      "type": "object",
      "properties": {
        "header": {
          "type": "string"
        },
        "footer": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "listNamePresentation": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        },
        "text": {
          "type": "string"
        },
        "skin": {
          "type": "string"
        },
        "ping": {
          "type": "integer",
          "minimum": -1,
          "maximum": 10000
        },
        "hat": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "column",
        "row"
      ],
      "additionalProperties": false
    },
    "skin": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "signature": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "sortKey": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "number",
            "text"
          ]
        },
        "direction": {
          "enum": [
            "ascending",
            "descending"
          ]
        }
      },
      "required": [
        "expression"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "filter": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sortKey"
          },
          "maxItems": 16
        },
        "overflow": {
          "enum": [
            "hide",
            "count"
          ]
        },
        "overflowFormat": {
          "type": "string"
        },
        "includeNpcs": {
          "type": "boolean",
          "default": false
        },
        "skin": {
          "type": "string"
        },
        "hat": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "id",
        "column",
        "row",
        "columns",
        "rows"
      ],
      "additionalProperties": false
    },
    "layoutPresentation": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "skins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/skin"
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    },
    "layoutVariant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer"
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "presentation": {
          "$ref": "#/$defs/layoutPresentation"
        }
      },
      "required": [
        "id",
        "when",
        "presentation"
      ],
      "additionalProperties": false
    }
  }
}
