{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volmit.com/gloss/holograms.schema.json",
  "title": "Gloss Hologram Document",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "anchor"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 3
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "anchor": {
      "type": "object",
      "required": [
        "world",
        "position"
      ],
      "properties": {
        "world": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "lines": {
      "description": "Authored lines, top to bottom. A string is a text row; an object carries an item, head, block or entity drawn under the text column.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "pages": {
      "description": "Pages replacing lines. Each viewer reads one page; navigate with mode page.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "actions": {
      "description": "Actions run when a viewer clicks the hologram's interaction box.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "hitbox": {
      "$ref": "#/$defs/hitbox"
    },
    "style": {
      "$ref": "#/$defs/iconDisplayStyle"
    },
    "box": {
      "$ref": "#/$defs/box"
    },
    "yaw": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "default": 0
    },
    "pitch": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "default": 0
    },
    "show": {
      "$ref": "#/$defs/show"
    },
    "particleLayers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/particleLayer"
      }
    }
  },
  "$defs": {
    "iconDisplayStyle": {
      "title": "Icon Display Style",
      "description": "Optional display-entity metadata shared by text, image, item, block, and custom-item icons. Packet entity icons do not accept this object.",
      "type": "object",
      "dependentRequired": {
        "blockLight": [
          "skyLight"
        ],
        "skyLight": [
          "blockLight"
        ]
      },
      "properties": {
        "billboard": {
          "type": "string",
          "enum": [
            "fixed",
            "vertical",
            "horizontal",
            "center"
          ],
          "default": "fixed"
        },
        "shadow": {
          "type": "boolean",
          "default": false
        },
        "seeThrough": {
          "type": "boolean",
          "default": false
        },
        "textAlignment": {
          "type": "string",
          "enum": [
            "center",
            "left",
            "right"
          ],
          "default": "center"
        },
        "backgroundArgb": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "default": "#00000000"
        },
        "textOpacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 255
        },
        "lineWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384,
          "default": 16384
        },
        "blockLight": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 15
        },
        "skyLight": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 15
        },
        "viewRange": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        },
        "shadowRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64,
          "default": 0
        },
        "shadowStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "cullingWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "default": 0
        },
        "cullingHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "default": 0
        },
        "glowColor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9A-Fa-f]{8}$"
        },
        "scaleX": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        },
        "scaleY": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        },
        "scaleZ": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "particleLayer": {
      "type": "object",
      "required": [
        "id",
        "target",
        "geometry",
        "particle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "target": {
          "type": "object",
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "enum": [
                "projection",
                "component",
                "text",
                "line",
                "span",
                "label",
                "model",
                "local"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "component": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "point",
                "line",
                "polyline",
                "outline",
                "filledPlane",
                "cuboid",
                "letterBounds",
                "glyphOutline",
                "glyphFill"
              ]
            },
            "from": {
              "$ref": "#/$defs/vector3"
            },
            "to": {
              "$ref": "#/$defs/vector3"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/vector3"
              }
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "spacing": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 16
            }
          }
        },
        "placement": {
          "type": "object",
          "properties": {
            "layer": {
              "enum": [
                "behind",
                "front",
                "center"
              ]
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "offset": {
              "$ref": "#/$defs/vector3"
            }
          }
        },
        "particle": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "size": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 4
            }
          }
        },
        "emission": {
          "type": "object",
          "properties": {
            "intervalTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "pattern": {
              "enum": [
                "steady",
                "chase",
                "pulse",
                "twinkle",
                "scan",
                "corners"
              ]
            },
            "periodTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 72000
            },
            "seed": {
              "type": "integer"
            }
          }
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "vector3": {
      "title": "3D Vector",
      "description": "Represents a 3D floating-point vector.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "box": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "default": 4
        },
        "borderWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 1
        },
        "backgroundArgb": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "default": "#B31B1B22"
        },
        "borderArgb": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "default": "#FFAAAAAA"
        }
      }
    },
    "show": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "Boolean or Gloss boolean expression. Entity variables include entity.name, named, type, health, maxHealth, healthPercent (0..100), damage, damaged, attack, armor, stackCount, distance, and insight.active. Viewer, world, server, time, permissions, groups, regions and integration functions use the shared condition scope."
    },
    "line": {
      "title": "Hologram Line",
      "description": "A text row, or an object with exactly one of text, item, head, block or entity.",
      "oneOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "description": "Text row source, run through the text pipeline.",
              "type": "string"
            },
            "item": {
              "description": "Menu icon data drawn as an item display.",
              "type": "object"
            },
            "head": {
              "description": "Player name whose head is drawn.",
              "type": "string",
              "minLength": 1
            },
            "block": {
              "description": "Block key drawn as a block display.",
              "type": "string",
              "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
            },
            "entity": {
              "description": "Entity type drawn as a raw packet entity.",
              "type": "string",
              "minLength": 1
            },
            "show": {
              "$ref": "#/$defs/show",
              "description": "Per-viewer condition; text rows only."
            },
            "scale": {
              "description": "Row height in blocks for object lines.",
              "type": "number",
              "minimum": 0.01,
              "maximum": 64,
              "default": 1
            }
          }
        }
      ]
    },
    "page": {
      "title": "Hologram Page",
      "type": "object",
      "required": [
        "id",
        "lines"
      ],
      "properties": {
        "id": {
          "description": "Page id used by navigate targets.",
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "description": "Lines shown while a viewer reads this page.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    },
    "hitbox": {
      "title": "Hologram Hitbox",
      "description": "The interaction box spawned for viewers within range when the hologram declares actions.",
      "type": "object",
      "properties": {
        "width": {
          "description": "Box width in blocks.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64,
          "default": 1.2
        },
        "height": {
          "description": "Box height per row in blocks.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64,
          "default": 0.35
        },
        "perLine": {
          "description": "One box per rendered row, each carrying its line index.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "action": {
      "title": "Hologram Action",
      "description": "Same shape as a menu action. Navigation additionally accepts mode page with target next, prev or a page id.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "description": "Action type.",
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "description": "Click binding. Omitted matches every accepted main-hand click.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "any",
            "left_click",
            "right_click",
            "shift_left_click",
            "shift_right_click",
            null
          ]
        },
        "mode": {
          "description": "Navigation mode; page moves the clicking viewer between hologram pages.",
          "type": "string",
          "enum": [
            "push",
            "replace",
            "back",
            "home",
            "close",
            "page"
          ]
        },
        "target": {
          "description": "Navigation target; for mode page this is next, prev or a page id.",
          "type": "string"
        },
        "when": {
          "description": "Condition evaluated for the clicking player before this action runs.",
          "type": "string"
        },
        "cooldownTicks": {
          "description": "Per-player cooldown in ticks after this action runs.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
