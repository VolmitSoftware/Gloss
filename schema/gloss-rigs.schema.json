{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volmit.com/gloss/rigs.schema.json",
  "title": "Gloss Rig Document",
  "description": "A bone tree of display-entity parts with clips, a state graph, hitboxes and level-of-detail tiers.",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "bones",
    "parts"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Document format revision. Always 1 for rigs.",
      "type": "integer",
      "const": 1
    },
    "revision": {
      "description": "Server-owned monotonic revision, raised on every save.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "show": {
      "$ref": "#/$defs/condition",
      "description": "Condition evaluated per viewer before any part is spawned."
    },
    "bones": {
      "description": "Bone tree. Parents must be declared and may not form a cycle.",
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/bone"
      }
    },
    "parts": {
      "description": "Display entities attached to bones. The rigs module caps the count with maxPartsPerRig.",
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "clips": {
      "description": "Named clips mapped to motion documents.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/clipRef"
      }
    },
    "graph": {
      "$ref": "#/$defs/graph",
      "description": "State machine driving which clip plays."
    },
    "hitboxes": {
      "description": "Interaction boxes spawned per viewer around a part.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/hitbox"
      }
    },
    "lod": {
      "$ref": "#/$defs/lod",
      "description": "Distance tiers that halve the clip rate, reduce to one part, then cull."
    },
    "audience": {
      "description": "Audience gate evaluated per viewer.",
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/condition",
          "description": "Condition a viewer must satisfy to receive this rig."
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "description": "Boolean or Gloss boolean expression. The rig namespace adds rig.state, rig.var.<name> and rig.instance.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "vector3": {
      "title": "3D Vector",
      "description": "Represents a 3D floating-point vector.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "transform": {
      "title": "Transform",
      "description": "Translation in blocks, rotation in degrees applied X then Y then Z, and scale multipliers.",
      "type": "object",
      "properties": {
        "translation": {
          "$ref": "#/$defs/vector3"
        },
        "rotation": {
          "$ref": "#/$defs/vector3"
        },
        "scale": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "bone": {
      "title": "Rig Bone",
      "description": "A named joint with a rest transform relative to its parent.",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "Bone id, unique within the rig.",
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "description": "Parent bone id, or null for a root bone.",
          "type": [
            "string",
            "null"
          ]
        },
        "rest": {
          "$ref": "#/$defs/transform",
          "description": "Rest pose relative to the parent bone."
        }
      }
    },
    "part": {
      "title": "Rig Part",
      "description": "One display entity bound to a bone.",
      "type": "object",
      "required": [
        "id",
        "bone",
        "type"
      ],
      "properties": {
        "id": {
          "description": "Part id, unique within the rig.",
          "type": "string",
          "minLength": 1
        },
        "bone": {
          "description": "Bone this part follows.",
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "Display entity kind.",
          "type": "string",
          "enum": [
            "block",
            "item",
            "text"
          ]
        },
        "block": {
          "description": "Block key for block parts.",
          "type": "string",
          "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"
        },
        "item": {
          "description": "Menu icon data for item parts.",
          "type": "object"
        },
        "text": {
          "description": "Text pipeline source for text parts.",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/transform",
          "description": "Local transform applied after the bone world transform."
        },
        "billboard": {
          "description": "Facing mode. Text parts default to center, others to fixed.",
          "type": "string",
          "enum": [
            "fixed",
            "vertical",
            "horizontal",
            "center"
          ]
        },
        "brightness": {
          "description": "Fixed light level, 0 to 15.",
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "style": {
          "description": "Display style overrides shared with menu icons.",
          "type": "object"
        }
      }
    },
    "clipRef": {
      "title": "Clip Reference",
      "description": "A motion id, or an object overriding the motion document's loop mode.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "motion"
          ],
          "properties": {
            "motion": {
              "type": "string",
              "minLength": 1
            },
            "loop": {
              "type": "string",
              "enum": [
                "once",
                "loop",
                "pingpong"
              ]
            }
          }
        }
      ]
    },
    "graph": {
      "title": "Rig State Graph",
      "type": "object",
      "required": [
        "initial",
        "states"
      ],
      "properties": {
        "initial": {
          "description": "State entered when the instance loads.",
          "type": "string",
          "minLength": 1
        },
        "states": {
          "description": "States by name.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "clip": {
                "description": "Clip name from the clips block.",
                "type": "string"
              },
              "then": {
                "description": "State entered when a once clip ends.",
                "type": "string"
              }
            }
          }
        },
        "transitions": {
          "description": "Transitions evaluated in order every ten ticks.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "when"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        }
      }
    },
    "hitbox": {
      "title": "Rig Hitbox",
      "description": "An Interaction entity spawned around a part for viewers within range.",
      "type": "object",
      "required": [
        "part"
      ],
      "properties": {
        "part": {
          "description": "Part the box follows.",
          "type": "string",
          "minLength": 1
        },
        "size": {
          "$ref": "#/$defs/vector3",
          "description": "Box extent in blocks, each axis within 0 to 64."
        },
        "actions": {
          "description": "Actions run when a viewer clicks the box.",
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "lod": {
      "title": "Rig Level Of Detail",
      "type": "object",
      "properties": {
        "reducedAt": {
          "description": "Distance in blocks where the clip rate halves.",
          "type": "number",
          "minimum": 0,
          "maximum": 512,
          "default": 32
        },
        "minimalAt": {
          "description": "Distance in blocks where only minimalPart remains.",
          "type": "number",
          "minimum": 0,
          "maximum": 512,
          "default": 64
        },
        "cullAt": {
          "description": "Distance in blocks where the rig despawns for the viewer.",
          "type": "number",
          "minimum": 0,
          "maximum": 512,
          "default": 96
        },
        "minimalPart": {
          "description": "Part kept at the minimal tier. Defaults to the first part.",
          "type": "string"
        }
      }
    }
  }
}
