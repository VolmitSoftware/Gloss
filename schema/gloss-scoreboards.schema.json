{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volmit.com/gloss/scoreboards.schema.json",
  "title": "Gloss Scoreboard Document",
  "type": "object",
  "properties": {
    "preset": {"type": ["string", "null"], "minLength": 1, "description": "Named preset from this collection in presets.json; document fields override inherited values."},
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "show": {
      "type": [
        "string",
        "boolean"
      ],
      "description": "Boolean or Gloss condition expression."
    },
    "select": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "integer"
        },
        "when": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "when"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer"
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "presentation": {
            "$ref": "#/$defs/presentation"
          }
        },
        "required": [
          "id",
          "when",
          "presentation"
        ],
        "additionalProperties": false
      }
    },
    "objectives": {
      "type": "object",
      "properties": {
        "playerList": {
          "$ref": "#/$defs/objective"
        },
        "belowName": {
          "$ref": "#/$defs/objective"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "revision"
  ],
  "additionalProperties": false,
  "$defs": {
    "presentation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "lines": {
          "$ref": "#/$defs/rows"
        },
        "hideNumbers": {
          "type": "boolean"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "format": {
          "enum": [
            "blank",
            "fixed",
            "styled",
            "number"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        },
        "show": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "section": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "section"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "format"
                  ]
                },
                {
                  "required": [
                    "id"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/line"
          }
        ]
      },
      "maxItems": 256
    },
    "layout": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/rows"
          }
        },
        "pages": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
              },
              "title": {
                "type": "string"
              },
              "lines": {
                "$ref": "#/$defs/rows"
              },
              "show": {
                "type": [
                  "string",
                  "boolean"
                ]
              },
              "durationTicks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 72000
              }
            },
            "additionalProperties": false,
            "required": [
              "id"
            ]
          }
        },
        "overflow": {
          "enum": [
            "truncate",
            "error"
          ]
        },
        "refresh": {
          "type": "object",
          "properties": {
            "titleTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 72000
            },
            "textTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 72000
            },
            "valueTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 72000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "renderType": {
          "enum": [
            "integer",
            "hearts"
          ]
        },
        "format": {
          "enum": [
            "blank",
            "fixed",
            "styled",
            "number"
          ]
        },
        "valueText": {
          "type": "string"
        },
        "show": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "subjects": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "refreshTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72000
        },
        "conflict": {
          "enum": [
            "yield",
            "override"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
