{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gloss names",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "materials": {
      "type": "object",
      "description": "Display names keyed by materials.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "entities": {
      "type": "object",
      "description": "Display names keyed by entities.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "worlds": {
      "type": "object",
      "description": "Display names keyed by worlds.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "gameModes": {
      "type": "object",
      "description": "Display names keyed by gameModes.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "object",
      "description": "Display names keyed by dimensions.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "damageCauses": {
      "type": "object",
      "description": "Display names keyed by damageCauses.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "effects": {
      "type": "object",
      "description": "Display names keyed by effects.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "groups": {
      "type": "object",
      "description": "Display names keyed by groups.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
