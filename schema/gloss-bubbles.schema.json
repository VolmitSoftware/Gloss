{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volmit.com/gloss/bubbles.schema.json",
  "title": "Gloss Chat Bubble Style",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 5
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "prefix": {
      "type": "string",
      "default": "&7"
    },
    "offset": {
      "$ref": "#/$defs/vector3"
    },
    "wordWrapChars": {
      "type": "integer",
      "minimum": 8,
      "maximum": 128
    },
    "maxAliveMs": {
      "type": "integer",
      "minimum": 500,
      "maximum": 60000
    },
    "followPlayer": {
      "type": "boolean",
      "default": false
    },
    "hideOwn": {
      "type": "boolean",
      "default": false
    },
    "motion": {
      "type": "object",
      "properties": {
        "translation": {
          "$ref": "#/$defs/axis"
        },
        "scale": {
          "$ref": "#/$defs/axis"
        },
        "rotation": {
          "$ref": "#/$defs/axis"
        },
        "opacity": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "shimmer": {
      "type": "object",
      "properties": {
        "spawn": {
          "type": "boolean"
        },
        "flyAway": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "durationMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "spawnDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "flyAwayLeadMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "select": {
      "type": "object",
      "required": [
        "when"
      ],
      "properties": {
        "priority": {
          "type": "integer"
        },
        "when": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "style": {
      "$ref": "#/$defs/iconDisplayStyle"
    },
    "box": {
      "$ref": "#/$defs/box"
    },
    "show": {
      "$ref": "#/$defs/show"
    },
    "particleLayers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/particleLayer"
      }
    }
  },
  "$defs": {
    "iconDisplayStyle": {
      "title": "Icon Display Style",
      "description": "Optional display-entity metadata shared by text, image, item, block, and custom-item icons. Packet entity icons do not accept this object.",
      "type": "object",
      "dependentRequired": {
        "blockLight": [
          "skyLight"
        ],
        "skyLight": [
          "blockLight"
        ]
      },
      "properties": {
        "billboard": {
          "type": "string",
          "enum": [
            "fixed",
            "vertical",
            "horizontal",
            "center"
          ],
          "default": "fixed"
        },
        "shadow": {
          "type": "boolean",
          "default": false
        },
        "seeThrough": {
          "type": "boolean",
          "default": false
        },
        "textAlignment": {
          "type": "string",
          "enum": [
            "center",
            "left",
            "right"
          ],
          "default": "center"
        },
        "backgroundArgb": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "default": "#00000000"
        },
        "textOpacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 255
        },
        "lineWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384,
          "default": 16384
        },
        "blockLight": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 15
        },
        "skyLight": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 15
        },
        "viewRange": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        },
        "shadowRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64,
          "default": 0
        },
        "shadowStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "cullingWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "default": 0
        },
        "cullingHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "default": 0
        },
        "glowColor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9A-Fa-f]{8}$"
        },
        "scaleX": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        },
        "scaleY": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        },
        "scaleZ": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "particleLayer": {
      "type": "object",
      "required": [
        "id",
        "target",
        "geometry",
        "particle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "target": {
          "type": "object",
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "enum": [
                "projection",
                "component",
                "text",
                "line",
                "span",
                "label",
                "model",
                "local"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "component": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "point",
                "line",
                "polyline",
                "outline",
                "filledPlane",
                "cuboid",
                "letterBounds",
                "glyphOutline",
                "glyphFill"
              ]
            },
            "from": {
              "$ref": "#/$defs/vector3"
            },
            "to": {
              "$ref": "#/$defs/vector3"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/vector3"
              }
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "spacing": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 16
            }
          }
        },
        "placement": {
          "type": "object",
          "properties": {
            "layer": {
              "enum": [
                "behind",
                "front",
                "center"
              ]
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "offset": {
              "$ref": "#/$defs/vector3"
            }
          }
        },
        "particle": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "size": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 4
            }
          }
        },
        "emission": {
          "type": "object",
          "properties": {
            "intervalTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "pattern": {
              "enum": [
                "steady",
                "chase",
                "pulse",
                "twinkle",
                "scan",
                "corners"
              ]
            },
            "periodTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 72000
            },
            "seed": {
              "type": "integer"
            }
          }
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "vector3": {
      "title": "3D Vector",
      "description": "Represents a 3D floating-point vector.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "box": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "default": 4
        },
        "borderWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 1
        },
        "backgroundArgb": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "default": "#B31B1B22"
        },
        "borderArgb": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "default": "#FFAAAAAA"
        }
      }
    },
    "show": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "Boolean or Gloss boolean expression. Entity variables include entity.name, named, type, health, maxHealth, healthPercent (0..100), damage, damaged, attack, armor, stackCount, distance, and insight.active. Viewer, world, server, time, permissions, groups, regions and integration functions use the shared condition scope."
    },
    "axis": {
      "type": "object",
      "properties": {
        "x": {
          "type": "string",
          "maxLength": 512
        },
        "y": {
          "type": "string",
          "maxLength": 512
        },
        "z": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
