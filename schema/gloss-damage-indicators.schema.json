{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volmit.com/gloss/damage-indicators.schema.json",
  "title": "Gloss Damage Indicators Document",
  "description": "Controls conditional damage and healing presentations, admission limits, and per-viewer audience selection. The document lives at plugins/Gloss/damage-indicators/default.json and hot reloads.",
  "type": "object",
  "required": ["schemaVersion", "revision", "limits", "damage", "healing", "audience"],
  "properties": {
    "schemaVersion": {
      "description": "Document format version. Must be exactly 2.",
      "type": "integer",
      "const": 2
    },
    "revision": {
      "description": "Server-owned monotonic revision counter.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "limits": {"$ref": "#/$defs/limits"},
    "damage": {
      "description": "Gate, fallback presentation, and complete variants for health loss.",
      "$ref": "#/$defs/style"
    },
    "healing": {
      "description": "Gate, fallback presentation, and complete variants for health gain.",
      "$ref": "#/$defs/style"
    },
    "audience": {
      "description": "Condition evaluated separately for every nearby viewer.",
      "$ref": "#/$defs/audience"
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "properties": {
        "maxPerSecond": {"type": "integer", "minimum": 1, "maximum": 1000},
        "lifetimeMs": {"type": "integer", "minimum": 250, "maximum": 30000},
        "minimumDelta": {"type": "number", "minimum": 0, "maximum": 1000},
        "decimals": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "style": {
      "type": "object",
      "required": ["when", "presentation", "variants"],
      "properties": {
        "when": {"type": "string", "minLength": 1},
        "presentation": {"$ref": "#/$defs/presentation"},
        "variants": {
          "description": "Complete conditional presentations ordered by highest priority and then lexicographically smallest id.",
          "type": "array",
          "items": {"$ref": "#/$defs/variant"}
        }
      }
    },
    "variant": {
      "type": "object",
      "required": ["id", "priority", "when", "presentation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "priority": {"description": "Higher values win.", "type": "integer"},
        "when": {"type": "string", "minLength": 1},
        "presentation": {"$ref": "#/$defs/completePresentation"}
      }
    },
    "audience": {
      "type": "object",
      "required": ["when"],
      "properties": {
        "when": {
          "description": "Boolean viewer condition. A false result excludes that viewer from the indicator whitelist.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "format": {"type": "string", "pattern": "\\{amount\\}"},
        "offset": {"$ref": "#/$defs/offset"},
        "motion": {"$ref": "#/$defs/motion"},
        "transform": {"$ref": "#/$defs/transform"}
      }
    },
    "completePresentation": {
      "type": "object",
      "required": ["format", "offset", "motion", "transform"],
      "properties": {
        "format": {"type": "string", "pattern": "\\{amount\\}"},
        "offset": {"$ref": "#/$defs/offset"},
        "motion": {"$ref": "#/$defs/completeMotion"},
        "transform": {"$ref": "#/$defs/completeTransform"}
      }
    },
    "offset": {
      "description": "Spawn offset from the affected entity as [x, y, z].",
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": -32, "maximum": 32},
        {"type": "number", "minimum": -32, "maximum": 32},
        {"type": "number", "minimum": -32, "maximum": 32}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "motion": {
      "type": "object",
      "properties": {
        "horizontalSpeed": {"type": "number", "minimum": 0, "maximum": 16},
        "verticalSpeed": {"type": "number", "minimum": -16, "maximum": 16},
        "verticalAcceleration": {"type": "number", "minimum": -32, "maximum": 32},
        "spinDegreesPerSecond": {"type": "number", "minimum": -1440, "maximum": 1440}
      }
    },
    "completeMotion": {
      "type": "object",
      "required": ["horizontalSpeed", "verticalSpeed", "verticalAcceleration", "spinDegreesPerSecond"],
      "properties": {
        "horizontalSpeed": {"type": "number", "minimum": 0, "maximum": 16},
        "verticalSpeed": {"type": "number", "minimum": -16, "maximum": 16},
        "verticalAcceleration": {"type": "number", "minimum": -32, "maximum": 32},
        "spinDegreesPerSecond": {"type": "number", "minimum": -1440, "maximum": 1440}
      }
    },
    "transform": {
      "type": "object",
      "properties": {
        "startScale": {"type": "number", "minimum": 0, "maximum": 16},
        "endScale": {"type": "number", "minimum": 0, "maximum": 16},
        "fadeStartFraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "completeTransform": {
      "type": "object",
      "required": ["startScale", "endScale", "fadeStartFraction"],
      "properties": {
        "startScale": {"type": "number", "minimum": 0, "maximum": 16},
        "endScale": {"type": "number", "minimum": 0, "maximum": 16},
        "fadeStartFraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
