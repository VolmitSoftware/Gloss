{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volmit.com/gloss/damage-indicators.schema.json",
  "title": "Gloss Damage Indicators Document",
  "description": "Controls conditional damage and healing presentations, admission limits, and per-viewer audience selection. The document lives at plugins/Gloss/damage-indicators/default.json and hot reloads.",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "limits",
    "damage",
    "healing",
    "audience"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Document format version. Must be exactly 4.",
      "type": "integer",
      "const": 4
    },
    "revision": {
      "description": "Server-owned monotonic revision counter.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "damage": {
      "description": "Gate, fallback presentation, and complete variants for health loss.",
      "$ref": "#/$defs/style"
    },
    "healing": {
      "description": "Gate, fallback presentation, and complete variants for health gain.",
      "$ref": "#/$defs/style"
    },
    "audience": {
      "description": "Condition evaluated separately for every nearby viewer.",
      "$ref": "#/$defs/audience"
    },
    "show": {
      "description": "Boolean or per-viewer expression combined with the audience condition.",
      "$ref": "#/$defs/show"
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "properties": {
        "maxPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "lifetimeMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 30000
        },
        "minimumDelta": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "when",
        "presentation",
        "variants"
      ],
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "variants": {
          "description": "Complete conditional presentations ordered by highest priority and then lexicographically smallest id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "when",
        "presentation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "priority": {
          "description": "Higher values win.",
          "type": "integer"
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "presentation": {
          "$ref": "#/$defs/completePresentation"
        }
      }
    },
    "audience": {
      "type": "object",
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "description": "Boolean viewer condition. A false result excludes that viewer from the indicator whitelist.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "format": {
          "description": "Authored text; optional {amount} expands to the measured health change.",
          "type": "string"
        },
        "offset": {
          "$ref": "#/$defs/offset"
        },
        "motion": {
          "$ref": "#/$defs/motion"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "particleLayers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/particleLayer"
          }
        },
        "style": {
          "description": "Shared text-display styling, composed with indicator motion.",
          "$ref": "#/$defs/iconDisplayStyle"
        },
        "box": {
          "description": "Measured panel and complete perimeter.",
          "$ref": "#/$defs/box"
        }
      }
    },
    "completePresentation": {
      "type": "object",
      "required": [
        "format",
        "offset",
        "motion",
        "transform"
      ],
      "properties": {
        "format": {
          "description": "Authored text; optional {amount} expands to the measured health change.",
          "type": "string"
        },
        "offset": {
          "$ref": "#/$defs/offset"
        },
        "motion": {
          "$ref": "#/$defs/completeMotion"
        },
        "transform": {
          "$ref": "#/$defs/completeTransform"
        },
        "particleLayers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/particleLayer"
          }
        },
        "style": {
          "description": "Shared text-display styling, composed with indicator motion.",
          "$ref": "#/$defs/iconDisplayStyle"
        },
        "box": {
          "description": "Measured panel and complete perimeter.",
          "$ref": "#/$defs/box"
        }
      }
    },
    "vector3": {
      "title": "3D Vector",
      "description": "Represents a 3D floating-point vector.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "particleLayer": {
      "type": "object",
      "required": [
        "id",
        "target",
        "geometry",
        "particle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "target": {
          "type": "object",
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "enum": [
                "projection",
                "component",
                "text",
                "line",
                "span",
                "label",
                "model",
                "local"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "component": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "point",
                "line",
                "polyline",
                "outline",
                "filledPlane",
                "cuboid",
                "letterBounds",
                "glyphOutline",
                "glyphFill"
              ]
            },
            "from": {
              "$ref": "#/$defs/vector3"
            },
            "to": {
              "$ref": "#/$defs/vector3"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/vector3"
              }
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 128
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "spacing": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 16
            }
          }
        },
        "placement": {
          "type": "object",
          "properties": {
            "layer": {
              "enum": [
                "behind",
                "front",
                "center"
              ]
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "offset": {
              "$ref": "#/$defs/vector3"
            }
          }
        },
        "particle": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "size": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 4
            }
          }
        },
        "emission": {
          "type": "object",
          "properties": {
            "intervalTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "pattern": {
              "enum": [
                "steady",
                "chase",
                "pulse",
                "twinkle",
                "scan",
                "corners"
              ]
            },
            "periodTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 72000
            },
            "seed": {
              "type": "integer"
            }
          }
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "offset": {
      "description": "Spawn offset from the affected entity as [x, y, z].",
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -32,
          "maximum": 32
        },
        {
          "type": "number",
          "minimum": -32,
          "maximum": 32
        },
        {
          "type": "number",
          "minimum": -32,
          "maximum": 32
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "motion": {
      "type": "object",
      "properties": {
        "horizontalSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "verticalSpeed": {
          "type": "number",
          "minimum": -16,
          "maximum": 16
        },
        "verticalAcceleration": {
          "type": "number",
          "minimum": -32,
          "maximum": 32
        },
        "spinDegreesPerSecond": {
          "type": "number",
          "minimum": -1440,
          "maximum": 1440
        }
      }
    },
    "completeMotion": {
      "type": "object",
      "required": [
        "horizontalSpeed",
        "verticalSpeed",
        "verticalAcceleration",
        "spinDegreesPerSecond"
      ],
      "properties": {
        "horizontalSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "verticalSpeed": {
          "type": "number",
          "minimum": -16,
          "maximum": 16
        },
        "verticalAcceleration": {
          "type": "number",
          "minimum": -32,
          "maximum": 32
        },
        "spinDegreesPerSecond": {
          "type": "number",
          "minimum": -1440,
          "maximum": 1440
        }
      }
    },
    "transform": {
      "type": "object",
      "properties": {
        "startScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "endScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "fadeStartFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "completeTransform": {
      "type": "object",
      "required": [
        "startScale",
        "endScale",
        "fadeStartFraction"
      ],
      "properties": {
        "startScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "endScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "fadeStartFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "iconDisplayStyle": {
      "title": "Icon Display Style",
      "description": "Optional display-entity metadata shared by text, image, item, block, and custom-item icons. Packet entity icons do not accept this object.",
      "type": "object",
      "dependentRequired": {
        "blockLight": [
          "skyLight"
        ],
        "skyLight": [
          "blockLight"
        ]
      },
      "properties": {
        "billboard": {
          "type": "string",
          "enum": [
            "fixed",
            "vertical",
            "horizontal",
            "center"
          ],
          "default": "fixed"
        },
        "shadow": {
          "type": "boolean",
          "default": false
        },
        "seeThrough": {
          "type": "boolean",
          "default": false
        },
        "textAlignment": {
          "type": "string",
          "enum": [
            "center",
            "left",
            "right"
          ],
          "default": "center"
        },
        "backgroundArgb": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "default": "#00000000"
        },
        "textOpacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 255
        },
        "lineWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384,
          "default": 16384
        },
        "blockLight": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 15
        },
        "skyLight": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 15
        },
        "viewRange": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        },
        "shadowRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64,
          "default": 0
        },
        "shadowStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "cullingWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "default": 0
        },
        "cullingHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "default": 0
        },
        "glowColor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9A-Fa-f]{8}$"
        },
        "scaleX": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        },
        "scaleY": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        },
        "scaleZ": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 64,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "box": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "default": 4
        },
        "borderWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 1
        },
        "backgroundArgb": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "default": "#B31B1B22"
        },
        "borderArgb": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "default": "#FFAAAAAA"
        }
      }
    },
    "show": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "Boolean or Gloss boolean expression. Entity variables include entity.name, named, type, health, maxHealth, healthPercent (0..100), damage, damaged, attack, armor, stackCount, distance, and insight.active. Viewer, world, server, time, permissions, groups, regions and integration functions use the shared condition scope."
    }
  }
}
