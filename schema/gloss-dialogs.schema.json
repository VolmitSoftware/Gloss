{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volmit.com/gloss/dialogs.schema.json",
  "title": "Gloss Dialog Document",
  "description": "A client-rendered dialog screen at plugins/Gloss/dialogs/<id>.json. Needs a 1.21.6 or newer client; older clients and Bedrock viewers take the fallback.",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": {
      "description": "Which of the five protocol screens to draw.",
      "type": "string",
      "enum": [
        "notice",
        "confirmation",
        "multi_action",
        "server_links",
        "dialog_list"
      ],
      "default": "notice"
    },
    "title": {
      "description": "Screen title, run through the text pipeline.",
      "type": "string"
    },
    "externalTitle": {
      "description": "Title shown in the pause menu's dialog list.",
      "type": "string"
    },
    "canCloseWithEscape": {
      "description": "Whether escape closes the screen. Default true.",
      "type": "boolean"
    },
    "pause": {
      "description": "Pauses a singleplayer world while open. Must not be combined with afterAction none.",
      "type": "boolean"
    },
    "afterAction": {
      "description": "What the client does after a button runs.",
      "type": "string",
      "enum": [
        "close",
        "none",
        "wait_for_response"
      ],
      "default": "close"
    },
    "body": {
      "description": "Paragraphs and item rows drawn above the controls.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "description": "text or item.",
            "type": "string",
            "enum": [
              "text",
              "item"
            ]
          },
          "text": {
            "description": "Paragraph text; required for a text body.",
            "type": "string"
          },
          "item": {
            "description": "Item drawn for an item body, in icon form.",
            "$ref": "https://volmit.com/gloss/schema.json#/$defs/icon"
          },
          "description": {
            "description": "Text drawn beside an item body.",
            "type": "string"
          },
          "showTooltip": {
            "description": "Whether the item shows its tooltip. Default true.",
            "type": "boolean"
          },
          "showDecorations": {
            "description": "Whether the item shows its decorations. Default true.",
            "type": "boolean"
          },
          "width": {
            "description": "Width in pixels, 1..1024.",
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "height": {
            "description": "Height in pixels for an item body, 1..1024.",
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          }
        }
      }
    },
    "inputs": {
      "description": "Controls the player fills in; their answers arrive as input.<key>.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "type": {
            "description": "Which control to draw.",
            "type": "string",
            "enum": [
              "text",
              "number",
              "option",
              "bool"
            ],
            "default": "text"
          },
          "key": {
            "description": "Answer key, unique in the document.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "description": "Label drawn for the control.",
            "type": "string"
          },
          "labelVisible": {
            "description": "Whether the label is drawn. Default true.",
            "type": "boolean"
          },
          "width": {
            "description": "Width in pixels, 1..1024.",
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "initial": {
            "description": "Starting value; a string for text, true/false for bool, a number for number."
          },
          "maxLength": {
            "description": "Maximum characters for a text control.",
            "type": "integer",
            "minimum": 1
          },
          "multiline": {
            "description": "Multi-line geometry for a text control.",
            "type": "object",
            "properties": {
              "maxLines": {
                "description": "Maximum lines.",
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "description": "Height in pixels.",
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "start": {
            "description": "Lowest value of a number control.",
            "type": "number"
          },
          "end": {
            "description": "Highest value of a number control; must exceed start.",
            "type": "number"
          },
          "step": {
            "description": "Step of a number control.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labelFormat": {
            "description": "Translation key formatting a number control's label.",
            "type": "string"
          },
          "options": {
            "description": "Entries of an option control.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "description": "Value sent back.",
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "description": "Text drawn for this entry.",
                  "type": "string"
                },
                "initial": {
                  "description": "Selects this entry at open; at most one may.",
                  "type": "boolean"
                }
              }
            }
          },
          "onTrue": {
            "description": "Substitution for a true bool control. Default \"true\".",
            "type": "string"
          },
          "onFalse": {
            "description": "Substitution for a false bool control. Default \"false\".",
            "type": "string"
          }
        }
      }
    },
    "buttons": {
      "description": "Buttons of a notice or multi_action dialog.",
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/button"
      }
    },
    "yes": {
      "description": "Confirming button of a confirmation dialog.",
      "$ref": "#/$defs/button"
    },
    "no": {
      "description": "Cancelling button of a confirmation dialog.",
      "$ref": "#/$defs/button"
    },
    "exit": {
      "description": "Button that leaves the screen.",
      "$ref": "#/$defs/button"
    },
    "columns": {
      "description": "Button columns, 1..16.",
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "buttonWidth": {
      "description": "Button width in pixels for server_links and dialog_list, 1..1024.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "dialogs": {
      "description": "Registered dialog ids listed by a dialog_list.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback": {
      "description": "Where a client that cannot draw dialogs goes instead.",
      "type": "object",
      "properties": {
        "inventory": {
          "description": "Inventory menu id, tried first.",
          "type": "string"
        },
        "menu": {
          "description": "Hologram menu id, tried second.",
          "type": "string"
        }
      }
    },
    "show": {
      "description": "Condition deciding whether this document is offered to a viewer at all.",
      "type": "string"
    },
    "select": {
      "description": "Board-model selection: the highest matching priority wins, ties break on the lowest id.",
      "type": "object",
      "properties": {
        "priority": {
          "description": "Higher wins.",
          "type": "integer"
        },
        "when": {
          "description": "Condition offering this document.",
          "type": "string"
        }
      }
    },
    "variants": {
      "description": "Conditional replacements of title, body and buttons. Nothing merges.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "presentation"
        ],
        "properties": {
          "id": {
            "description": "Variant id.",
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "description": "Higher wins.",
            "type": "integer"
          },
          "when": {
            "description": "Condition selecting this variant.",
            "type": "string"
          },
          "presentation": {
            "description": "The replacement screen.",
            "type": "object",
            "properties": {
              "title": {
                "description": "Replacement title.",
                "type": "string"
              },
              "body": {
                "description": "Replacement body.",
                "type": "array"
              },
              "buttons": {
                "description": "Replacement buttons.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/button"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "button": {
      "title": "Dialog Button",
      "description": "One clickable button. Its actions are the same list every other Gloss surface takes.",
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "description": "Button text.",
          "type": "string",
          "minLength": 1
        },
        "tooltip": {
          "description": "Hover text.",
          "type": "string"
        },
        "width": {
          "description": "Width in pixels, 1..1024.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "actions": {
          "description": "Actions run on click.",
          "type": "array",
          "items": {
            "$ref": "https://volmit.com/gloss/schema.json#/$defs/action"
          }
        }
      }
    }
  }
}
