{
  "schemaVersion": 1,
  "revision": 1,
  "show": false,
  "select": {
    "priority": 0,
    "when": "true",
    "permission": ""
  },
  "presentation": {
    "lines": [
      {
        "text": "{{ subject.name }}",
        "show": "true"
      },
      {
        "text": "{{ bar(subject.health, subject.maxHealth, 10, '&c|', '&8|') }}",
        "show": "subject.health < subject.maxHealth"
      }
    ],
    "offset": 0.3,
    "hideSneaking": true,
    "relations": [
      {
        "when": "hasPermission('subject', 'server.staff')",
        "color": "&c"
      }
    ]
  },
  "variants": []
}
