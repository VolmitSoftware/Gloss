    },
    {
      "name": "lid",
      "from": [0, 8, 0],
      "to": [16, 12, 16],
      "origin": [8, 8, 8],
      "rotation": [0, 0, 0],
      "uuid": "cube-lid",
      "faces": { "north": { "uv": [0, 0, 16, 4], "texture": 0 } }
    }
  ],
  "outliner": [
    {
      "name": "root",
      "uuid": "group-root",
      "origin": [8, 0, 8],
      "rotation": [0, 0, 0],
      "children": [
        "cube-base",
        {
          "name": "lid",
          "uuid": "group-lid",
          "origin": [8, 8, 8],
