  },
  "items": {
    "enabled": true,
    "token": "[item]",
    "permission": "gloss.chat.item"
  },
  "links": {
    "enabled": true,
    "render": "&9&n{{ link.host }}"
  },
  "filters": [],
  "throttle": {
    "repeatWindowTicks": 100,
    "maxRepeats": 1,
    "minIntervalTicks": 10
  },
  "variants": []
