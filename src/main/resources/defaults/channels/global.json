{
  "schemaVersion": 1,
  "revision": 1,
  "show": "true",
  "channel": {
    "name": "global",
    "aliases": [ "g" ],
    "default": true,
    "scope": "global",
    "radius": 0,
    "permission": "",
    "priority": 0,
    "cooldownTicks": 0
  },
  "format": "<hover:show_text:'{{ card }}'>&7[{{ sender.group }}]</hover> &f{{ sender.name }}&8: &f{{ message }}",
