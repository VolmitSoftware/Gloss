{
  "schemaVersion": 2,
  "revision": 1,
  "show": "true",
  "channel": {
    "name": "global",
    "aliases": [ "g" ],
    "default": true,
    "scope": "global",
    "radius": 0,
    "permission": "",
    "priority": 0,
    "cooldownTicks": 0
  },
  "format": "<hover:show_text:'{{ card }}'>{{ sender.groupName != '' ? '&7[' + sender.groupName + ']' : '' }}</hover> &f{{ sender.name }}&8: &f{{ message }}",
  "card": [
    "&6{{ sender.name }}",
    "&7World &f{{ sender.worldName }}"
  ],
  "mentions": {
    "enabled": true,
    "pattern": "@{name}",
    "render": "<gold><bold>@{{ mention.name }}</bold></gold>",
    "messageFormat": "<yellow>{{ sender.name }}: {{ message }}</yellow>",
    "sound": "minecraft:block.note_block.bell",
    "permission": "gloss.chat.mention"
  },
  "items": {
    "enabled": true,
    "token": "[item]",
    "permission": "gloss.chat.item"
  },
  "links": {
    "enabled": true,
    "render": "&9&n{{ link.host }}"
  },
  "filters": [],
  "filtering": { "syntax": "re2" },
  "throttle": {
    "repeatWindowTicks": 100,
    "maxRepeats": 1,
    "minIntervalTicks": 10
  },
  "variants": []
}
